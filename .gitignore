# Terraform
# downloaded provider plugins — large and machine-specific
.terraform/
# state file: records every resource, can contain secrets in plaintext
*.tfstate
# Terraform's auto-backup of the above
*.tfstate.backup
# Terraform crash dumps
crash.log

# Python
# compiled bytecode caches
__pycache__/
*.pyc
# pytest's cache
.pytest_cache/
# local virtual environment — never ship this
.venv/

# Build artifacts
# where deploy.sh assembles the Lambda zip — regenerated every deploy
build/
*.zip

# Secrets / local config
# often holds account IDs, the Slack webhook, etc. — keep out of Git
*.tfvars
.env
# private keys — must NEVER be committed
*.pem